{
  "name": "small-change",
  "title": "小修复或明确小改动",
  "adapter": "local-governed",
  "contract_path": ".agentic/workflow/small-change.md",
  "primary_inputs": ["goal", "goal_path"],
  "stages": ["validate-input", "execute", "verify-and-fix", "independent-review", "report"],
  "verify_policy": "targeted",
  "worktree": false,
  "parallelism": 1,
  "nodes": [
    {
      "id": "validate-input",
      "type": "deterministic_gate",
      "required_artifacts": []
    },
    {
      "id": "execute",
      "type": "adapter_command",
      "command": "ao-small-execute",
      "depends_on": [
        "validate-input"
      ],
      "required_artifacts": ["implementation.md", "changed-files.txt"]
    },
    {
      "id": "verify-and-fix",
      "type": "adapter_command",
      "command": "ao-small-verify",
      "depends_on": [
        "execute"
      ],
      "required_artifacts": [
        {
          "path": "verification.md",
          "kind": "markdown",
          "validators": [
            "non_placeholder"
          ]
        }
      ]
    },
    {
      "id": "independent-review",
      "type": "adapter_command",
      "command": "ao-small-review",
      "depends_on": [
        "verify-and-fix"
      ],
      "required_artifacts": [
        {
          "path": "review.md",
          "kind": "markdown",
          "validators": [
            "non_placeholder"
          ]
        }
      ]
    }
  ]
}
