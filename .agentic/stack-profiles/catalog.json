{
  "schema_version": 1,
  "default_profile": "default-web-app",
  "profiles": [
    {
      "id": "default-web-app",
      "label": "默认 Web 应用",
      "description": "适合多数业务系统，默认技术栈覆盖 Web 前端、Python 后端、本地数据库，不包含独立客户端。",
      "technology_stack": {
        "frontend": "React + TypeScript + Vite + npm",
        "backend": "Python + FastAPI + pytest + uv/pip",
        "client": "无独立客户端",
        "database": "SQLite"
      },
      "components": [
        {
          "component_id": "frontend",
          "kind": "frontend",
          "language": "typescript",
          "framework": "react-vite",
          "root": "frontend",
          "package_manager": "npm"
        },
        {
          "component_id": "backend",
          "kind": "service",
          "language": "python",
          "framework": "fastapi",
          "root": "backend",
          "package_manager": "uv-or-pip"
        },
        {
          "component_id": "database",
          "kind": "database",
          "language": "sql",
          "framework": "sqlite",
          "root": "data",
          "package_manager": "none"
        }
      ],
      "commands": {
        "verify_all": ["python scripts/ao.py verify"]
      }
    }
  ]
}
