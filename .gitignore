# Local workspace outputs
/output/
/dist/

# Local reference notes
/refs/codex-db/
/refs/design/

# Agent workflow scratch space
/ai_docs/

# Git worktrees (temporary workspaces)
.agentic/worktrees/

# Local business workspaces; never committed in this control-plane repo
/apps/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Node
node_modules/

# Local logs
.logs/

# Runtime logs
data/runtime/*.err.log
data/runtime/*.out.log
backend/*.err.log
backend/*.out.log
frontend/*.err.log
frontend/*.out.log
vite*.log

# Local runtime inspection scripts
data/runtime/inspect_*.py
data/tmp-validation.json

# Local dev helper scripts (use python scripts/ao.py as persistent entry)
scripts/*.cmd
scripts/*.ps1

# SQLite runtime files (locks, WAL, backups)
*.sqlite-shm
*.sqlite-wal
*.bak-*

# Local environment
.env
.env.*
!.env.example

# Runtime data (generated at runtime)
data/runtime/
data/logs/

# Data directory runtime artifacts
data/packages/
data/manual-real-collector/
data/manual-real-collector-clean/
data/manual-real-collector-final/
data/manual-real-collector-final2/
data/manual-real-collector-single/
data/manual-real-collector-v2/

# Agent Observer runtime databases (kept in backend/data/ for tests)
data/*.sqlite

# Frontend build/test artifacts
frontend/tsconfig.tsbuildinfo
frontend/test-results/
frontend/data/runtime/
frontend/apps/

# Backend data (keep only migrations, not runtime DBs)
backend/data/*.sqlite
backend/data/*.db
backend/data/packages/
backend/data/logs/
backend/logs/
backend/*.sqlite
backend/*.db
backend/app/*.sqlite
backend/app/*.db
backend/app/db/*.sqlite
backend/app/db/*.db
backend/check_codex_data.py

# Backend runtime config/state (auto-generated by collector)
backend/agent-observer.config.json
backend/agent-observer.state.json

# Temporary test files
test-*.txt

# Trae IDE runtime (workspace, specs, etc.)
.trae/