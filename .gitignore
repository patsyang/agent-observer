# Local workspace outputs
/output/
/dist/

# Local reference notes
/refs/codex-db/
/refs/design/

# Agent workflow scratch space
/ai_docs/

# Git worktrees (temporary workspaces)
.agentic/worktrees/

# Local business workspaces; never committed in this control-plane repo
/apps/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Node
node_modules/

# Local logs
.logs/

# Runtime logs
data/runtime/*.err.log
data/runtime/*.out.log
backend/*.err.log
backend/*.out.log
frontend/*.err.log
frontend/*.out.log
vite*.log

# Local runtime inspection scripts
data/runtime/inspect_*.py

# SQLite runtime files (locks, WAL, backups)
*.sqlite-shm
*.sqlite-wal
*.bak-*

# Local environment
.env
.env.*
!.env.example

# Runtime data (generated at runtime)
data/runtime/screenshots/
data/runtime/debug-validation.json
data/runtime/agent-observer-windows-*.zip
data/runtime/manual-collector/
data/runtime/manual-collector-current/
data/runtime/manual-collector-latest/

