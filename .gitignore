data/manual-real-collector-final/
data/manual-real-collector-final2/
data/manual-real-collector-single/
data/manual-real-collector-v2/

# Agent Observer runtime databases (kept in backend/data/ for tests)
data/*.sqlite

# Frontend build/test artifacts
frontend/tsconfig.tsbuildinfo
frontend/test-results/
frontend/data/runtime/

# Backend data (keep only migrations, not runtime DBs)
backend/data/*.sqlite
